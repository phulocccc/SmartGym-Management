@page
@model SmartGymManagement.Areas.Identity.Pages.Account.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Đăng ký hội viên"; }
<h1>Đăng ký hội viên</h1>
<form method="post" class="col-md-6">
 <div asp-validation-summary="All" class="text-danger"></div>
 <div class="mb-3"><label asp-for="Input.FullName">Họ tên</label><input asp-for="Input.FullName" class="form-control" /></div>
 <div class="mb-3"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email" class="form-control" autocomplete="username" /></div>
 <div class="mb-3"><label asp-for="Input.Password">Mật khẩu</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /></div>
 <div class="mb-3"><label asp-for="Input.ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
 <button type="submit" class="btn btn-primary">Đăng ký</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

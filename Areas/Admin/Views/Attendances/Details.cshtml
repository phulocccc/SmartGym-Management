@model SmartGymManagement.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";
}

<h1>Attendance Details</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-bordered">
    <tr>
        <th>Member</th>
        <td>@Model.Member?.User?.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Member?.User?.Email</td>
    </tr>

    <tr>
        <th>Class</th>
        <td>@Model.ClassSchedule?.ClassName</td>
    </tr>

    <tr>
        <th>Trainer</th>
        <td>@Model.ClassSchedule?.Trainer?.FullName</td>
    </tr>

    <tr>
        <th>Room</th>
        <td>@Model.ClassSchedule?.Room?.RoomName</td>
    </tr>

    <tr>
        <th>Class Time</th>
        <td>
            @Model.ClassSchedule?.StartTime.ToString("dd/MM/yyyy HH:mm")
            -
            @Model.ClassSchedule?.EndTime.ToString("HH:mm")
        </td>
    </tr>

    <tr>
        <th>Check-in Time</th>
        <td>@Model.CheckInTime.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>

    <tr>
        <th>Check-in Method</th>
        <td>@Model.Method</td>
    </tr>

    <tr>
        <th>Booking Status</th>
        <td>@Model.Booking?.Status</td>
    </tr>

    <tr>
        <th>Note</th>
        <td>@Model.Note</td>
    </tr>
</table>

<a asp-area="Admin"
   asp-controller="Attendances"
   asp-action="Index"
   class="btn btn-secondary">
    Back
</a>
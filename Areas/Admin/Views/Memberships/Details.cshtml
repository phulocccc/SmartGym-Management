@model SmartGymManagement.Models.Membership
@using SmartGymManagement.Models

@{
    ViewData["Title"] = "Membership Details";
    var payments = ViewBag.Payments as List<PaymentTransaction>;
    var invoices = ViewBag.Invoices as List<Invoice>;
}

<h1>Membership Details</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-bordered">
    <tr>
        <th>Member</th>
        <td>@Model.Member?.User?.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Member?.User?.Email</td>
    </tr>

    <tr>
        <th>Package</th>
        <td>@(Model.PurchasedPackageName ?? Model.Package?.PackageName)</td>
    </tr>

    <tr>
        <th>Duration</th>
        <td>@(Model.PurchasedDurationDays ?? (Model.EndDate.Date - Model.StartDate.Date).Days + 1) ngày hiệu lực</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@((Model.PurchasedPrice ?? payments?.Sum(p => p.Amount))?.ToString("N0")) VND</td>
    </tr>

    <tr>
        <th>Start Date</th>
        <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
    </tr>

    <tr>
        <th>End Date</th>
        <td>@Model.EndDate.ToString("dd/MM/yyyy")</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@SmartGymManagement.Services.MembershipDisplay.Status(Model)</td>
    </tr>

    <tr>
        <th>Created At</th>
        <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>
</table>

<h3>Payment Transactions</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Transaction Code</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Note</th>
        </tr>
    </thead>

    <tbody>
@if (payments != null && payments.Any())
{
    foreach (var payment in payments)
    {
        <tr>
            <td>@payment.TransactionCode</td>
            <td>@payment.Amount.ToString("N0") VND</td>
            <td>@payment.PaymentMethod</td>
            <td>@payment.Status</td>
            <td>@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@payment.Note</td>
        </tr>
    }
}
else
{
        <tr>
            <td colspan="6">No payment transactions found.</td>
        </tr>
}
    </tbody>
</table>

<h3>Invoices</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Invoice Number</th>
            <th>Total Amount</th>
            <th>Issue Date</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
@if (invoices != null && invoices.Any())
{
    foreach (var invoice in invoices)
    {
        <tr>
            <td>@invoice.InvoiceNumber</td>
            <td>@invoice.TotalAmount.ToString("N0") VND</td>
            <td>@invoice.IssueDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@invoice.Status</td>
        </tr>
    }
}
else
{
        <tr>
            <td colspan="4">No invoices found.</td>
        </tr>
}
    </tbody>
</table>

<a asp-area="Admin" asp-controller="Memberships" asp-action="Index" class="btn btn-secondary">
    Back
</a>

<a asp-area="Admin" asp-controller="Memberships" asp-action="Cancel" asp-route-id="@Model.MembershipId" class="btn btn-danger">
    Cancel Membership
</a>
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (Model.Status == SmartGymManagement.Enums.MembershipStatus.Pending)
{
 <h3>Xác nhận đã nhận tiền</h3>
 <p>Chỉ xác nhận sau khi kiểm tra biên nhận hoặc giao dịch thực tế. Đây là ghi nhận thủ công.</p>
 <form asp-action="ConfirmPayment" asp-route-id="@Model.MembershipId" method="post">
  <input name="reference" maxlength="100" required class="form-control mb-2" placeholder="Mã đối soát / biên nhận" />
  <button class="btn btn-success" type="submit">Xác nhận thanh toán</button>
 </form>
}
@if (Model.Status == SmartGymManagement.Enums.MembershipStatus.Cancelled)
{
 <h3>Ghi nhận hoàn tiền</h3>
 <p>Chỉ xác nhận sau khi đã hoàn toàn bộ tiền thực tế. Hệ thống không tự chuyển tiền.</p>
 <form asp-action="ConfirmRefund" asp-route-id="@Model.MembershipId" method="post">
  <input name="reference" maxlength="100" required class="form-control mb-2" placeholder="Mã biên nhận hoàn tiền" />
  <button class="btn btn-warning" type="submit">Xác nhận đã hoàn tiền</button>
 </form>
}

@model SmartGymManagement.Models.Membership

@{
    ViewData["Title"] = "Cancel Membership";
}

<h1>Cancel Membership</h1>

<h4>Are you sure you want to cancel this membership?</h4>

<p class="text-warning">
    The membership will be marked as Cancelled. Related invoices will also be marked as Cancelled.
</p>

<table class="table table-bordered">
    <tr>
        <th>Member</th>
        <td>@Model.Member?.User?.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Member?.User?.Email</td>
    </tr>

    <tr>
        <th>Package</th>
        <td>@(Model.PurchasedPackageName ?? Model.Package?.PackageName)</td>
    </tr>

    <tr>
        <th>Start Date</th>
        <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
    </tr>

    <tr>
        <th>End Date</th>
        <td>@Model.EndDate.ToString("dd/MM/yyyy")</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@SmartGymManagement.Services.MembershipDisplay.Status(Model)</td>
    </tr>
</table>

<form asp-area="Admin" asp-controller="Memberships" asp-action="Cancel" method="post">
    <input type="hidden" asp-for="MembershipId" />

    <button type="submit" class="btn btn-danger">Cancel Membership</button>

    <a asp-area="Admin" asp-controller="Memberships" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>
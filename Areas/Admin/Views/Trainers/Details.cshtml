@model SmartGymManagement.Models.Trainer

@{
    ViewData["Title"] = "Trainer Details";
}

<h1>Trainer Details</h1>

<table class="table table-bordered">
    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Specialization</th>
        <td>@Model.Specialization</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Experience Years</th>
        <td>@Model.ExperienceYears</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>
</table>

<a asp-area="Admin" asp-controller="Trainers" asp-action="Edit" asp-route-id="@Model.TrainerId" class="btn btn-warning">
    Edit
</a>

<a asp-area="Admin" asp-controller="Trainers" asp-action="Index" class="btn btn-secondary">
    Back
</a>
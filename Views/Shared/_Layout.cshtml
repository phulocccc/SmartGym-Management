@using Microsoft.AspNetCore.Identity
@using SmartGymManagement.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Smart Gym</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartGymManagement.styles.css"
          asp-append-version="true" />

    <style>
        body {
            background: #f3f5f8;
        }

        .navbar-brand {
            font-weight: 900;
            letter-spacing: 0.3px;
        }

        .brand-mark {
            display: inline-flex;
            width: 34px;
            height: 34px;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #0d6efd;
            color: #ffffff;
            margin-right: 8px;
            font-weight: 900;
        }

        .main-container {
            min-height: calc(100vh - 155px);
            padding-top: 24px;
            padding-bottom: 32px;
        }

        .content-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            padding: 26px;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
        }

        .dropdown-menu {
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
        }

        .dropdown-header {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
        }

        .dropdown-item {
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .footer {
            background: #ffffff;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">SG</span>
                    <span>Smart Gym</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="adminDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Admin Management
                                </a>

                                <ul class="dropdown-menu"
                                    aria-labelledby="adminDropdown">

                                    <li>
                                        <h6 class="dropdown-header">
                                            Dashboard
                                        </h6>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Reports"
                                           asp-action="Index">
                                            Reports & Analytics
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <h6 class="dropdown-header">
                                            Gym Setup
                                        </h6>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="MembershipPackages"
                                           asp-action="Index">
                                            Membership Packages
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Trainers"
                                           asp-action="Index">
                                            Trainers
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Rooms"
                                           asp-action="Index">
                                            Rooms
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="ClassSchedules"
                                           asp-action="Index">
                                            Class Schedules
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <h6 class="dropdown-header">
                                            Operations
                                        </h6>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Members"
                                           asp-action="Index">
                                            Members
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Memberships"
                                           asp-action="Index">
                                            Memberships
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Index">
                                            Bookings
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Attendances"
                                           asp-action="Index">
                                            Attendances
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Member"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="memberDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Member Portal
                                </a>

                                <ul class="dropdown-menu"
                                    aria-labelledby="memberDropdown">

                                    <li>
                                        <h6 class="dropdown-header">
                                            My Gym
                                        </h6>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="MemberDashboard"
                                           asp-action="Index">
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="MemberBookings"
                                           asp-action="AvailableClasses">
                                            Book Classes
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="MemberBookings"
                                           asp-action="MyBookings">
                                            My Bookings
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <h6 class="dropdown-header">
                                            Fitness
                                        </h6>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="MemberBMI"
                                           asp-action="Index">
                                            Body Metrics
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="MemberChatbot"
                                           asp-action="Index">
                                            Smart Gym Assistant
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main">
            @RenderBody()
            <partial name="_Pagination" />
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - Smart Gym Management System -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    @if (User.IsInRole("Member"))
    {
        <div class="container mb-3"><a asp-area="" asp-controller="MemberNotifications" asp-action="Index">Thông báo lớp học và gói tập</a> | <a asp-area="" asp-controller="MemberProfile" asp-action="Index">Hồ sơ hội viên</a></div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @if (User.Identity != null &&
         User.Identity.IsAuthenticated &&
         User.IsInRole("Member"))
    {
        <partial name="_MemberChatWidget" />
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>